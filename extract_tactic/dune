; coqc-loadable tactic plugin providing [confirm_extraction "<hash>"].
;
; Rocq 9 port: opam's rocq-runtime installs neither the coqpp binary nor a
; coqpp findlib library, so the grammar .ml cannot be generated at build
; time.  g_confirm_extraction.ml is CHECKED IN, generated from the sibling
; .mlg with Coq 8.20's coqpp (the output uses only stable plugin API:
; Mltop/Tacentries/Stdarg/Genarg).  Regenerate with any coqpp if the .mlg
; changes.  Library names follow the 9.x rename (coq-core -> rocq-runtime).
(library
 (name coq_lsp_confirm_extraction)
 (public_name coq-lsp.confirm-extraction)
 (synopsis "coqc tactic: confirm_extraction <hash> (staleness check)")
 (modules g_confirm_extraction confirm_extraction)
 (wrapped false)
 (flags (:standard -w -27-32-33-37-39))
 (libraries
  rocq-runtime.kernel
  rocq-runtime.engine
  rocq-runtime.interp
  rocq-runtime.printing
  rocq-runtime.tactics
  rocq-runtime.plugins.ltac))
